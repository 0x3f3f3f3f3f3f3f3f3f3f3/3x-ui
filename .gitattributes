# LF in every checkout, Windows included: format-check, the msw worker check and
# tests that parse repo files compare bytes, so a CRLF working copy fails them.
* text=auto eol=lf

# Unified patch context requires a leading space, including on blank/tabbed lines.
tools/managed-xray/patches/*.patch whitespace=-blank-at-eol,-space-before-tab
tools/managed-mieru/*.patch whitespace=-blank-at-eol,-space-before-tab
