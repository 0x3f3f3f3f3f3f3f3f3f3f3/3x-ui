@@ -0,0 +1,87 @@
+package trojan
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"io"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/log"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func (s *Server) processManaged(ctx context.Context, conn stat.Connection, dispatcher routing.Dispatcher) error {
+	if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		return err
+	}
+	var probe [100]byte
+	if _, err := io.ReadFull(conn, probe[:]); err != nil {
+		return errors.New("incomplete managed authentication").Base(err)
+	}
+	if !bytes.Equal(probe[56:68], []byte{'\r', '\n', 0x7f, 0, 0, 0, 0, 0, 0, 0, '\r', '\n'}) {
+		return errors.New("invalid managed authentication")
+	}
+	user := s.validator.Get(hexString(probe[:56]))
+	if user == nil {
+		return errors.New("invalid managed user")
+	}
+	mac := hmac.New(sha256.New, []byte(user.Account.(*MemoryAccount).Password))
+	_, _ = mac.Write([]byte("3x-ui-managed/1"))
+	_, _ = mac.Write(probe[68:])
+	reply := append([]byte{'X', 'U', 'I', 1}, mac.Sum(nil)...)
+	if n, err := conn.Write(reply); err != nil {
+		return err
+	} else if n != len(reply) {
+		return io.ErrShortWrite
+	}
+	var command [1]byte
+	if _, err := io.ReadFull(conn, command[:]); err != nil {
+		if err == io.EOF {
+			return nil
+		}
+		return err
+	}
+	network := net.Network_TCP
+	switch command[0] {
+	case commandTCP:
+	case commandUDP:
+		network = net.Network_UDP
+	default:
+		return errors.New("invalid managed command")
+	}
+	address, port, err := addrParser.ReadAddressPort(nil, conn)
+	if err != nil {
+		return err
+	}
+	var delimiter [2]byte
+	if _, err := io.ReadFull(conn, delimiter[:]); err != nil {
+		return err
+	}
+	if delimiter != [2]byte{'\r', '\n'} || port == 0 || address == nil {
+		return errors.New("invalid managed target")
+	}
+	if err := conn.SetDeadline(time.Time{}); err != nil {
+		return err
+	}
+	destination := net.Destination{Address: address, Port: port, Network: network}
+	inbound := session.InboundFromContext(ctx)
+	inbound.Name = "xui-managed"
+	inbound.User = user
+	inbound.CanSpliceCopy = 3
+	inbound.ManagedPacketPeer = true
+	sessionPolicy := s.policyManager.ForLevel(user.Level)
+	if network == net.Network_UDP {
+		return s.handleUDPPayload(ctx, sessionPolicy, &PacketReader{Reader: conn, FixedTarget: &destination}, &PacketWriter{Writer: conn}, dispatcher)
+	}
+	ctx = log.ContextWithAccessMessage(ctx, &log.AccessMessage{
+		From: conn.RemoteAddr(), To: destination, Status: log.AccessAccepted, Email: user.Email,
+	})
+	return s.handleConnection(ctx, sessionPolicy, destination, buf.NewReader(conn), buf.NewWriter(conn), dispatcher)
+}
